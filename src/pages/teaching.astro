---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { dateRange } from '../lib/format';

const teaching = (await getCollection('teaching')).sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

---
<PageLayout
  title="Teaching"
  eyebrow="Backprop"
  lead="Courses I have been at as a teaching assistant. I am always glad to discuss various topics on AI with students."
  description="Teaching and academic services."
>
  <section class="block">
    <h2 class="block-title">Teaching assistant experience</h2>
    <ul class="rows">
      {
        teaching.map((t) => (
          <li class="row">
            <div class="row-date">{dateRange(t.data.startDate, t.data.endDate)}</div>
            <div>
              <p class="row-title">{t.data.title}</p>
              <p class="row-meta muted">
                {t.data.role} · {t.data.venue}
                {t.data.location ? ` · ${t.data.location}` : ''}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</PageLayout>

<style>
  .block {
    margin-bottom: var(--space-16);
  }
  .block-title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0 1.5rem;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-rule);
  }
  .row--stack {
    display: block;
  }
  .row-date {
    font-family: var(--font-display);
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .row-title {
    font-weight: var(--fw-semibold);
    font-size: 1.05rem;
  }
  .row-meta {
    margin-top: 0.3rem;
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .row-links {
    margin-top: 0.45rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    font-size: var(--fs-small);
  }
  .row-links a {
    color: var(--color-accent);
  }
  .row-links a:hover {
    text-decoration: underline;
  }
  .algo-teaching-row {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .algo-teaching-leading {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 0.15rem;
  }
  .algo-teaching-leading a {
    display: inline-flex;
    text-decoration: none;
    transition: transform var(--transition);
  }
  .algo-teaching-row:hover .algo-teaching-leading a {
    transform: scale(1.08);
  }
  .algo-teaching-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .algo-row-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .algo-row-title {
    font-weight: var(--fw-semibold);
    font-size: 1.05rem;
  }
  .algo-row-title a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .algo-row-title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .algo-tag {
    font-size: var(--fs-meta);
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    color: var(--color-accent-dark);
    border-radius: var(--radius);
  }
  .all-algos-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition: all 0.15s ease;
  }
  .all-algos-link:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    color: var(--color-accent-dark);
  }
  .review-intro {
    margin-bottom: var(--space-4);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .journals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .journals li {
    font-size: var(--fs-small);
    padding: 0.35em 0.8em;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-muted);
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
