<div class="readbar" data-readbar aria-hidden="true" transition:persist="readbar"><span class="readbar-fill"></span></div>

<style>
  .readbar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 200;
    pointer-events: none;
    background: color-mix(in srgb, var(--color-rule) 45%, transparent);
  }
  .readbar-fill {
    display: block;
    height: 100%;
    width: calc(var(--p, 0) * 100%);
    background-color: var(--color-accent);
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0 5px,
      color-mix(in srgb, var(--color-bg) 22%, transparent) 5px 6px
    );
    position: relative;
    overflow: hidden;
  }
  .readbar-fill::after {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    width: 26px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--color-accent) 65%, var(--color-on-accent))
    );
  }
</style>

<script>
  let bar: HTMLElement | null = null;
  let ticking = false;

  const update = () => {
    ticking = false;
    if (!bar?.isConnected) bar = document.querySelector<HTMLElement>('[data-readbar]');
    if (!bar) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    bar.style.setProperty('--p', p.toFixed(4));
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();
  document.addEventListener('astro:page-load', update);
</script>
